{
  "name": "Pocket Fitness",
  "short_name": "Fitness",
  "description": "Your training log: workouts, routines, a weekly plan and personal records.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f6f8",
  "theme_color": "#d9480f",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    }
  ],
  "shortcuts": [
    {
      "name": "Start a workout",
      "url": "/?start=1"
    },
    {
      "name": "History",
      "url": "/history"
    },
    {
      "name": "Progress",
      "url": "/progress"
    }
  ]
}
